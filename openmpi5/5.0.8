#%Module1.0#####################################################################

proc ModulesHelp { } {

puts stderr " "
puts stderr "This module loads the openmpi4 library built with the gnu14 toolchain."
puts stderr "\nVersion 5.0.8\n"

}

module-whatis "Name: openmpi5 built with gnu14 toolchain"
module-whatis "Version: 5.0.8"
module-whatis "Category: runtime library"
module-whatis "Description: A powerful implementation of MPI"
module-whatis "URL: http://www.open-mpi.org"

set     version                     5.0.8
set     package                     openmpi5
set     category                    mpi
set     root                        /opt/ohpc/pub/$category/$package/$version
set     stubs_path                  /opt/ohpc/pub/compiler/cuda/12.9.1/lib64/stubs
set     targets_path                /opt/ohpc/pub/compiler/cuda/12.9.1/targets/x86_64-linux/lib

setenv          MPI_DIR             $root
prepend-path    PATH                $root/bin
prepend-path    MANPATH             $root/share/man
prepend-path    LD_LIBRARY_PATH     $root/lib
prepend-path    LD_RUN_PATH         $root/lib
prepend-path    CPATH               $root/include
prepend-path    PKG_CONFIG_PATH     $root/lib/pkgconfig

setenv          OMPI_MCA_btl_openib_allow_ib true
setenv          OMPI_MCA_btl_openib_warn_default_gid_prefix false
setenv          OMPI_MCA_orte_base_help_aggregate 0

family "MPI"

#------------------------------------------------------------------------------
# Detect GPU or libcuda.so availability (at module load time)
#------------------------------------------------------------------------------
set gpu_detected 0

# Try nvidia-smi first
if { [catch {exec nvidia-smi -L} result] == 0 && [string length $result] > 0 } {
    set gpu_detected 1
} else {
    # If nvidia-smi not available, check for libcuda.so in system libs
    if { [catch {exec ldconfig -p | grep libcuda.so} result] == 0 && [string length $result] > 0 } {
        set gpu_detected 1
    }
    prepend-path LD_LIBRARY_PATH $targets_path
}

#------------------------------------------------------------------------------
# Environment setup
#------------------------------------------------------------------------------
if { $gpu_detected == 0 } {
    puts stderr "No GPU detected, using CUDA stubs library."
    prepend-path LD_LIBRARY_PATH $stubs_path:$targets_path
    setenv OMPI_MCA_opal_cuda_support 0
    setenv UCX_TLS ^cuda
} else {
    puts stderr "GPU detected, using system-installed libcuda.so."
}

#------------------------------------------------------------------------------
# Load dependencies
#------------------------------------------------------------------------------
module try-load hwloc/2.12.1
module try-load cuda/12.9.1
module try-load pmix/5.0.8
module try-load singularity/4.3.2
module try-load ucx/1.20.0
